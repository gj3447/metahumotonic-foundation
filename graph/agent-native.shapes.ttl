@prefix av: <https://github.com/gj3447/metahumotonic-foundation/agent-native-vocab#> .
@prefix an: <https://github.com/gj3447/metahumotonic-foundation/graph/agent-native#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
av:ArtifactShape a sh:NodeShape ; sh:targetClass av:Artifact ;
  sh:property [ sh:path av:path ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path av:sha256 ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^[0-9a-f]{64}$" ] ;
  sh:property [ sh:path av:state ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue "WORKTREE_SNAPSHOT" ] .
av:UserClaimShape a sh:NodeShape ; sh:targetClass av:UserClaim ;
  sh:property [ sh:path av:authority ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue "USER_PRIMARY" ] ;
  sh:property [ sh:path av:state ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue "STATED" ] ;
  sh:property [ sh:path av:text ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path dcterms:source ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue an:artifact_source ] ;
  sh:property [ sh:path prov:wasAttributedTo ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue <https://github.com/gj3447/metahumotonic-foundation/graph/spirit#proposer> ] ;
  sh:property [ sh:path av:recordedOn ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:date ] .
av:DesignShape a sh:NodeShape ; sh:targetClass av:Design ;
  sh:property [ sh:path av:authority ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue "SECONDARY_AI" ] ;
  sh:property [ sh:path av:state ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue "PROPOSED" ] ;
  sh:property [ sh:path av:text ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path dcterms:source ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue an:artifact_report ] ;
  sh:property [ sh:path prov:wasDerivedFrom ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue an:priority ] ;
  sh:property [ sh:path prov:wasAttributedTo ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue <https://github.com/gj3447/metahumotonic-foundation/graph/philosophy#codex> ] .
av:DesignShape sh:property [ sh:path av:targets ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ; sh:property [ sh:path dcterms:references ; sh:minCount 1 ; sh:class av:Observation ] .
av:ObservationShape a sh:NodeShape ; sh:targetClass av:Observation ;
  sh:property [ sh:path av:authority ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue "DOCUMENT_OBSERVATION" ] ;
  sh:property [ sh:path av:state ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue "PARAPHRASE" ] ;
  sh:property [ sh:path av:text ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path av:limitation ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
  sh:property [ sh:path av:section ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path dcterms:source ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path dcterms:hasVersion ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path av:recordedOn ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:date ] ;
  sh:property [ sh:path dcterms:references ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue an:artifact_research ] .
av:RunShape a sh:NodeShape ; sh:targetClass av:Run ;
  sh:property [ sh:path av:authority ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue "SYSTEM_DERIVED" ] ;
  sh:property [ sh:path av:state ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue "LOCAL_SIMULATION" ] ;
  sh:property [ sh:path av:sha256 ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^[0-9a-f]{64}$" ] ;
  sh:property [ sh:path av:scenario ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ("paid_demand" "subsidy_only" "cost_shock" "faulty_provider") ] ;
  sh:property [ sh:path dcterms:source ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue an:artifact_suite ] ;
  sh:property [ sh:path prov:wasAssociatedWith ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue an:simulator ] ;
  sh:property [ sh:path av:recordedOn ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:date ] ;
  sh:property [ sh:path av:seed ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ] ;
  sh:property [ sh:path av:completed ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ] ;
  sh:property [ sh:path av:failed ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ] ;
  sh:property [ sh:path av:postBootstrap ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ] ;
  sh:property [ sh:path av:installedCapacity ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ] ;
  sh:property [ sh:path av:sharedCapacity ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ] .
