@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix mhv: <https://github.com/gj3447/metahumotonic-foundation/vocab#> .
@prefix eco: <https://github.com/gj3447/metahumotonic-foundation/graph/economy#> .

mhv:EconomyGraphShape a sh:NodeShape ;
  sh:targetClass mhv:EconomyGraph ;
  sh:property [ sh:path mhv:claimStatus ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue mhv:CONSIDERATION ] ;
  sh:property [ sh:path mhv:inEffect ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue false ] ;
  sh:property [ sh:path mhv:governanceEffect ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue false ] ;
  sh:property [ sh:path mhv:usesArtifact ; sh:minCount 1 ; sh:maxCount 1 ; sh:class mhv:File ] ;
  sh:property [ sh:path prov:wasGeneratedBy ; sh:minCount 1 ; sh:maxCount 1 ; sh:class prov:Activity ] ;
  sh:property [ sh:path prov:wasAttributedTo ; sh:minCount 1 ; sh:maxCount 1 ; sh:class prov:SoftwareAgent ] .

mhv:EconomyActivityShape a sh:NodeShape ;
  sh:targetNode eco:engineering ;
  sh:property [ sh:path prov:wasAssociatedWith ; sh:minCount 1 ; sh:maxCount 1 ; sh:class prov:SoftwareAgent ] ;
  sh:property [ sh:path prov:used ; sh:minCount 3 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path dcterms:date ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:date ] .

mhv:EconomyArtifactShape a sh:NodeShape ;
  sh:targetObjectsOf mhv:usesArtifact ;
  sh:property [ sh:path mhv:path ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path mhv:sha256 ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^[0-9a-f]{64}$" ] ;
  sh:property [ sh:path mhv:gitCommit ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^[0-9a-f]{40}$" ] .

mhv:ConceptShape a sh:NodeShape ;
  sh:targetClass mhv:Concept ;
  sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] .
mhv:CoinConceptShape a sh:NodeShape ;
  sh:targetNode eco:metahumocoin ;
  sh:class mhv:Concept ;
  sh:not [ sh:class mhv:ExternalImplementation ] ;
  sh:not [ sh:class mhv:Project ] .
mhv:ClaimTopicShape a sh:NodeShape ;
  sh:targetSubjectsOf mhv:topic ;
  sh:class mhv:Claim ;
  sh:property [ sh:path mhv:topic ; sh:class mhv:Concept ] .

# Add exact-span and source-author checks to the existing Claim shapes.
mhv:ExactSourceSpanShape a sh:NodeShape ;
  sh:targetClass mhv:Claim ;
  sh:sparql [ sh:message "Claim span is not in its original source, or attribution differs" ;
    sh:select """
      PREFIX mhv: <https://github.com/gj3447/metahumotonic-foundation/vocab#>
      PREFIX prov: <http://www.w3.org/ns/prov#>
      SELECT $this WHERE {
        $this mhv:span ?span ; prov:wasDerivedFrom ?u ; prov:wasAttributedTo ?author .
        ?u mhv:verbatim ?raw ; prov:wasAttributedTo ?sourceAuthor .
        FILTER(STRLEN(STR(?span)) = 0 || !CONTAINS(STR(?raw), STR(?span)) || ?author != ?sourceAuthor)
      }
    """ ] .

mhv:SourceDocumentShape a sh:NodeShape ;
  sh:targetClass mhv:SourceDocument ;
  sh:property [ sh:path dcterms:source ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:pattern "^https://" ] ;
  sh:property [ sh:path dcterms:publisher ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path dcterms:hasVersion ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path mhv:observedOn ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:date ] .
mhv:ExternalImplementationShape a sh:NodeShape ;
  sh:targetClass mhv:ExternalImplementation ;
  sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path dcterms:source ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:pattern "^https://" ] ;
  sh:property [ sh:path dcterms:hasVersion ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^[0-9a-f]{40}$" ] ;
  sh:property [ sh:path dcterms:references ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path mhv:observedOn ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:date ] .

mhv:DocumentedMechanismShape a sh:NodeShape ;
  sh:targetClass mhv:DocumentedMechanism ;
  sh:property [ sh:path mhv:implementation ; sh:minCount 1 ; sh:maxCount 1 ; sh:class mhv:ExternalImplementation ] ;
  sh:property [ sh:path mhv:sourceDocument ; sh:minCount 1 ; sh:class mhv:SourceDocument ] ;
  sh:property [ sh:path mhv:text ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path mhv:limitation ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path mhv:observedOn ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:date ] ;
  sh:property [ sh:path mhv:evidenceStatus ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue mhv:DOCUMENTED ] ;
  sh:property [ sh:path mhv:summaryAuthority ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue mhv:SECONDARY_AI ] ;
  sh:property [ sh:path prov:wasAttributedTo ; sh:minCount 1 ; sh:maxCount 1 ; sh:class prov:SoftwareAgent ] .

mhv:DesignComponentShape a sh:NodeShape ;
  sh:targetClass mhv:DesignComponent ;
  sh:class mhv:Concept ;
  sh:property [ sh:path mhv:text ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] .

mhv:DesignProposalShape a sh:NodeShape ;
  sh:targetClass mhv:DesignProposal ;
  sh:not [ sh:class mhv:Claim ] ;
  sh:property [ sh:path mhv:text ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path mhv:limitation ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path mhv:proposalStatus ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue mhv:PROPOSED ] ;
  sh:property [ sh:path mhv:summaryAuthority ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue mhv:SECONDARY_AI ] ;
  sh:property [ sh:path prov:wasAttributedTo ; sh:minCount 1 ; sh:maxCount 1 ; sh:class prov:SoftwareAgent ] ;
  sh:property [ sh:path prov:wasDerivedFrom ; sh:minCount 1 ; sh:maxCount 1 ; sh:class mhv:Utterance ] ;
  sh:property [ sh:path mhv:basedOn ; sh:minCount 1 ; sh:class mhv:Claim ] ;
  sh:property [ sh:path mhv:borrowsFrom ; sh:minCount 1 ; sh:class mhv:DocumentedMechanism ] ;
  sh:property [ sh:path mhv:targets ; sh:minCount 1 ; sh:class mhv:DesignComponent ] ;
  sh:property [ sh:path mhv:requiresDecision ; sh:minCount 1 ; sh:class mhv:OpenDecision ] .

mhv:OpenDecisionShape a sh:NodeShape ;
  sh:targetClass mhv:OpenDecision ;
  sh:class mhv:Question ;
  sh:property [ sh:path mhv:proposalStatus ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue mhv:OPEN ] ;
  sh:property [ sh:path mhv:summaryAuthority ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue mhv:SECONDARY_AI ] ;
  sh:property [ sh:path prov:wasAttributedTo ; sh:minCount 1 ; sh:maxCount 1 ; sh:class prov:SoftwareAgent ] .
