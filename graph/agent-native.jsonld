        "an:cycle"
      ]
    },
    {
      "@id": "an:correction_perspectives",
      "@type": "av:ContextCorrection",
      "text": "ㅇㅇ Metahumo 그리고 오퍼레이터도 있거든 확인해주고 ㅇㅇ 그 좀 다자적으로 해석해 너무 이건 이거다 이렇게 가지말고",
      "authority": "USER_PRIMARY",
      "state": "STATED",
