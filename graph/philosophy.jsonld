        "ph:C_mission",
        "sp:P3"
      ],
      "discusses": [
        "eco:freedom",
        "ph:ultra_safety"
      ],
      "compares": [
        "ph:O_license",
        "ph:O_charter",
        "ph:O_owner"
      ],
      "openQuestion": [
        "ph:Q_resources"
      ]
    },
