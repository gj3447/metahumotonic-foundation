    {
      "@id": "ph:Q_mhc_obligation",
      "@type": [
        "phv:Analysis",
        "phv:OpenQuestion",
        "prov:Entity"
      ],
      "label": "통화 참여와 공유 의무·상환 조건의 적용 범위",
      "text": "보유자·결제자·소프트웨어 운영자·제공자 중 공유 의무의 주체는 누구인가? 제공량·기간·수혜자·철회·미이행 처리와 단일 MHC의 서비스 교환 조건은 무엇인가? 다른 통화와 구현으로 이동할 수 있는 상태에서도 MHC의 유용성과 공유 참여가 유지되는가?",
      "authorityClass": "SECONDARY_AI",
      "adoptionStatus": "PROPOSED",
      "date": "2026-10-06",
      "attributedTo": "ph:codex",
