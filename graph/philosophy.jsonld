    {
      "@id": "ph:T_authority",
      "@type": [
        "phv:Analysis",
        "phv:Tension",
        "prov:Entity"
      ],
      "label": "자원 공유와 통제권 집중",
      "text": "자원이 여러 사람에게서 모이더라도, 통제권이 한 운영자에게 집중되면 자유를 확대한다는 목적과 긴장이 생겨. 현재 LICENSE의 전체 관리 권한 조건과 HSWM 실행 owner 규칙의 프로젝트 한정 조건도 별도 조정이 필요한 문서상 긴장이다. 그래프 작성은 어느 규칙도 개정하거나 접근을 승인하지 않는다.",
      "authorityClass": "SECONDARY_AI",
      "adoptionStatus": "PROPOSED",
      "date": "2026-10-03",
      "attributedTo": "ph:codex",
      "derivedFrom": "ph:a_centralization",
      "groundedIn": [
        "ph:C_mission",
        "sp:P3"
      ],
      "discusses": [
        "eco:freedom",
        "ph:ultra_safety"
      ],
      "compares": [
        "ph:O_license",
        "ph:O_charter",
        "ph:O_owner"
      ],
      "openQuestion": [
        "ph:Q_resources"
      ]
    },
    {
      "@id": "ph:T_incentives",
      "@type": [
        "phv:Analysis",
        "phv:Tension",
        "prov:Entity"
      ],
      "label": "보상과 검증의 충돌",
      "text": "연산량이나 성공 신고에 치우친 보상은 불필요한 작업·실패 은폐를 유도할 가능성이 있다. 기여 판정과 화폐 발행·지급의 권한을 분리하고 정직한 정정의 유인을 실험해야 한다.",
