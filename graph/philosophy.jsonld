        "ph:O_research_cooperation"
      ]
    },
    {
      "@id": "ph:I_mhc_reserve",
      "@type": [
        "phv:Analysis",
        "phv:Interpretation",
        "prov:Entity"
      ],
      "label": "MHC의 기축통화 역할: 가격 표시·정산·연산 예산 보유",
      "text": "사용자의 기축통화 비유를 에이전트와 제공자가 서비스 가격을 MHC로 표시하고, 거래를 MHC로 정산하며, 미래 연산 예산을 MHC로 보유하는 공통 통화 역할로 해석한다. 컴퓨팅 자원 기준 안정성을 추구하며 달러 페그를 뜻하지 않는다. MHC가 널리 받아들여지는 유용성을 전략적 목표로 삼되, 전체 세계의 기축통화가 되어야만 소규모 자율 경제가 작동한다는 필요조건은 주장하지 않는다. 추론 토큰은 모델·버전에 종속되고 단일 영구 MHC와 기간별 서비스 청구권의 연결은 여전히 열린 설계다.",
      "authorityClass": "SECONDARY_AI",
      "adoptionStatus": "PROPOSED",
      "date": "2026-10-06",
      "attributedTo": "ph:codex",
      "derivedFrom": "ph:a_mhc_ideal",
      "groundedIn": [
        "ph:C_mhc_reserve",
        "ph:C_network_sharing",
        "ph:C_autonomous_ideal",
        "ph:C_intervention_safety"
      ],
      "discusses": [
        "eco:metahumocoin",
        "eco:freedom",
        "eco:economy",
        "ph:consensus",
        "ph:ultra_safety"
      ],
