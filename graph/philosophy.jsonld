    {
      "@id": "ph:C_build",
      "@type": "mhv:Claim",
      "label": "사용자의 그래프 구축 요청",
      "text": "표준 그래프 엔지니어링으로 파운데이션에 구축해줘봐봐 ㅇㅇ",
      "span": "표준 그래프 엔지니어링으로 파운데이션에 구축해줘봐봐 ㅇㅇ",
      "order": 2,
      "claimStatus": "mhv:STATED",
      "authorityClass": "USER_PRIMARY",
