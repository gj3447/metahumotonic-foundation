    {
      "@id": "fr:artifact_governance",
      "@type": "rv:Artifact",
      "path": "records/2026-10-04/foundation-rationale/GOVERNANCE.md",
      "sha256": "6af4379a7cebbcd46b98447b1abea9c387a06ba6b7d5da847e01a58e9cb238e5",
      "artifactState": "WORKTREE_SNAPSHOT",
      "recordedOn": "2026-10-04"
    },
    {
      "@id": "fr:S_governance",
      "@type": "rv:Observation",
      "recordKey": "governance",
      "mode": "EXACT_EXCERPT",
      "text": "문서에 `approved`라고 쓰는 것만으로는 결정이 성립하지 않습니다.",
      "source": "fr:artifact_governance",
      "locator": "GOVERNANCE.md: exact excerpt in pinned local snapshot",
      "authorityClass": "DOCUMENT_OBSERVATION",
      "attributedTo": "fr:codex",
