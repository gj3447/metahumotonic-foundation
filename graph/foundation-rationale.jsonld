    {
      "@id": "fr:M_ostrom",
      "@type": "rv:MappingProposal",
      "role": "COMMON_GOVERNANCE",
      "text": "자원 집단 사이의 공통 규칙·분쟁 조정",
      "targets": [
        "ph:foundation",
