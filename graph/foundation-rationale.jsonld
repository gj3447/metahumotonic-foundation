      "limitation": "Local repository declaration/design, not external validation or policy ratification."
    },
    {
      "@id": "fr:artifact_notice",
      "@type": "rv:Artifact",
      "path": "records/2026-10-04/foundation-rationale/LICENSE-NOTICE.md",
      "sha256": "6babd0233d5e8f828fe2f5254696ff1f2021684a6d0641842a2955f6793db661",
      "artifactState": "WORKTREE_SNAPSHOT",
      "recordedOn": "2026-10-04"
    },
    {
      "@id": "fr:S_notice",
