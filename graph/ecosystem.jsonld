      ],
      "unitSpec": "ex:unit_response"
    },
    {
      "@id": "ex:state",
      "@type": [
        "ev:Design",
        "ev:ComponentSpec"
      ],
      "label": "Semantic Weight 하이퍼그래프 상태",
      "text": "역할·문맥에 조건화된 의미 관계와 실행 계보가 지속되고 후속 국소 연산을 조건화하는 상태. 고정 H/W/A/F 분해를 새 정본으로 도입하지 않는다.",
