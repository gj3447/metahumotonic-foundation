  "questions": [
    {
      "id": "CQ1",
      "question": "재단의 목적은 누구의 어느 원문에 근거하는가?",
      "columns": [
        "claim",
        "source",
        "author",
        "span"
      ],
      "query": "SELECT ?claim ?source ?author ?span WHERE { VALUES ?claim { ph:C_mission } ?claim prov:wasDerivedFrom ?source ; prov:wasAttributedTo ?author ; mhv:span ?span . }",
      "expected": [
        [
          "ph:C_mission",
          "ph:u_purpose",
          "sp:proposer",
          "우리는 자유 경제 합의 Ultra Safty AI 를 개발하는곳이야"
        ]
      ]
    },
    {
      "id": "CQ2",
      "question": "목적에 연결되는 네 주제는 무엇인가?",
      "columns": [
        "topic",
        "source"
      ],
      "query": "SELECT ?topic ?source WHERE { ph:C_mission mhv:topic ?topic ; prov:wasDerivedFrom ?source . }",
      "expected": [
        [
          "eco:freedom",
          "ph:u_purpose"
        ],
        [
          "eco:economy",
          "ph:u_purpose"
        ],
        [
          "ph:consensus",
          "ph:u_purpose"
        ],
        [
          "ph:ultra_safety",
          "ph:u_purpose"
        ]
      ]
    },
    {
