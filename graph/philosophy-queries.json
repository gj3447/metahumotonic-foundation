    {
      "id": "CQ5",
      "question": "안전성 가설과 실험은 어떤 검증 상태인가?",
      "columns": [
        "hypothesis",
        "epistemic",
        "plan",
        "verification"
      ],
      "query": "SELECT ?hypothesis ?epistemic ?plan ?verification WHERE { ?plan phv:testsHypothesis ?hypothesis ; phv:verificationStatus ?verification . ?hypothesis mhv:epistemic ?epistemic . }",
      "expected": [
        [
          "ph:H_safety",
          "mhv:UNVERIFIED",
          "ph:E_protocol",
          "NOT_RUN"
        ]
